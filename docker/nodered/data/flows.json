    {
        "id": "0c8f74381a99c757",
        "type": "function",
        "z": "12e532b125237eb5",
        "name": "function 3",
        "func": "const uplink_msg = msg.payload.uplink_message;\nconst dp = uplink_msg.decoded_payload;\nconst rx_meta = uplink_msg.rx_metadata[0];\n\nmsg.payload = [\n    {\n        temp: dp.temperature,\n        hum: dp.humidity,\n        rssi: rx_meta.rssi,\n        snr: rx_meta.snr,\n        timeStampTTN: msg.payload.received_at  // timestamp de TTN\n        // los campos que tenga tu formatter\n    },\n    {\n        device: msg.payload.end_device_ids.device_id  // como tag\n    }\n];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
